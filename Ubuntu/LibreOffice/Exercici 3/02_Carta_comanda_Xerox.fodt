<?xml version="1.0" encoding="UTF-8"?><office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:version="1.2"><office:automatic-styles><style:page-layout style:name="pm1"><style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="2cm" fo:margin-bottom="2cm" fo:margin-left="2.2cm" fo:margin-right="2.2cm"/></style:page-layout><style:style style:name="Body" style:family="paragraph"><style:paragraph-properties fo:text-align="justify" fo:line-height="125%" fo:margin-bottom="0.22cm"/><style:text-properties style:font-name="Liberation Sans" fo:font-size="10.5pt" fo:color="#252b35"/></style:style><style:style style:name="Title" style:family="paragraph"><style:paragraph-properties fo:text-align="center" fo:margin-top="0.5cm" fo:margin-bottom="0.2cm"/><style:text-properties style:font-name="Liberation Serif" fo:font-size="23pt" fo:font-weight="bold" fo:color="#17365d"/></style:style><style:style style:name="Org" style:family="paragraph"><style:paragraph-properties fo:text-align="center" fo:margin-bottom="0.25cm"/><style:text-properties style:font-name="Liberation Sans" fo:font-size="9pt" fo:font-weight="bold" fo:color="#536579"/></style:style><style:style style:name="Subhead" style:family="paragraph"><style:paragraph-properties fo:margin-top="0.3cm" fo:margin-bottom="0.12cm"/><style:text-properties style:font-name="Liberation Sans" fo:font-size="11pt" fo:font-weight="bold" fo:color="#17365d"/></style:style><style:style style:name="Callout" style:family="paragraph"><style:paragraph-properties fo:text-align="center" fo:margin-top="0.25cm" fo:margin-bottom="0.3cm"/><style:text-properties style:font-name="Liberation Sans" fo:font-size="12pt" fo:font-weight="bold" fo:color="#1f6b78"/></style:style><style:style style:name="Footer" style:family="paragraph"><style:paragraph-properties fo:text-align="center"/><style:text-properties fo:font-size="8pt" fo:color="#6b7280"/></style:style></office:automatic-styles><office:master-styles><style:master-page style:name="Standard" style:page-layout-name="pm1"><style:header><text:p text:style-name="Footer">IES JOAN RAMIS I RAMIS · CARTA COMERCIAL</text:p></style:header><style:footer><text:p text:style-name="Footer">Model acadèmic · emplenau els camps entre claudàtors</text:p></style:footer></style:master-page></office:master-styles><office:body><office:text><text:p text:style-name="Org">IES JOAN RAMIS I RAMIS</text:p><text:p text:style-name="Title">Sol·licitud de comanda de dues impressores multifunció</text:p><text:p text:style-name="Callout">CARTA COMERCIAL</text:p><text:p text:style-name="Body">A l’atenció del departament comercial de Xerox Menorca</text:p><text:p text:style-name="Body">Benvolguts/des,</text:p><text:p text:style-name="Body">Per mitjà d’aquesta carta, l’IES Joan Ramis i Ramis manifesta el seu interès a adquirir dues impressores multifunció de la marca Xerox per a les necessitats administratives i docents del centre.</text:p><text:p text:style-name="Body">Us demanam una oferta detallada amb el model i les característiques tècniques, el preu unitari i total amb IVA, el termini i les condicions de lliurament, la instal·lació, la garantia, el servei tècnic i les opcions de manteniment.</text:p><text:p text:style-name="Body">La comanda definitiva quedarà condicionada a l’aprovació del pressupost per part del centre. Agrairem que ens confirmeu la disponibilitat dels equips i la validesa de l’oferta.</text:p><text:p text:style-name="Body">Maó, [data]</text:p><text:p text:style-name="Body">Direcció · IES Joan Ramis i Ramis</text:p></office:text></office:body></office:document>