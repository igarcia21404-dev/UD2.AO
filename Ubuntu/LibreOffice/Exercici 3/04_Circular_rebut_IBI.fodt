<?xml version="1.0" encoding="UTF-8"?><office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:version="1.2"><office:automatic-styles><style:page-layout style:name="pm1"><style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="2cm" fo:margin-bottom="2cm" fo:margin-left="2.2cm" fo:margin-right="2.2cm"/></style:page-layout><style:style style:name="Body" style:family="paragraph"><style:paragraph-properties fo:text-align="justify" fo:line-height="125%" fo:margin-bottom="0.22cm"/><style:text-properties style:font-name="Liberation Sans" fo:font-size="10.5pt" fo:color="#252b35"/></style:style><style:style style:name="Title" style:family="paragraph"><style:paragraph-properties fo:text-align="center" fo:margin-top="0.5cm" fo:margin-bottom="0.2cm"/><style:text-properties style:font-name="Liberation Serif" fo:font-size="23pt" fo:font-weight="bold" fo:color="#17365d"/></style:style><style:style style:name="Org" style:family="paragraph"><style:paragraph-properties fo:text-align="center" fo:margin-bottom="0.25cm"/><style:text-properties style:font-name="Liberation Sans" fo:font-size="9pt" fo:font-weight="bold" fo:color="#536579"/></style:style><style:style style:name="Subhead" style:family="paragraph"><style:paragraph-properties fo:margin-top="0.3cm" fo:margin-bottom="0.12cm"/><style:text-properties style:font-name="Liberation Sans" fo:font-size="11pt" fo:font-weight="bold" fo:color="#17365d"/></style:style><style:style style:name="Callout" style:family="paragraph"><style:paragraph-properties fo:text-align="center" fo:margin-top="0.25cm" fo:margin-bottom="0.3cm"/><style:text-properties style:font-name="Liberation Sans" fo:font-size="12pt" fo:font-weight="bold" fo:color="#1f6b78"/></style:style><style:style style:name="Footer" style:family="paragraph"><style:paragraph-properties fo:text-align="center"/><style:text-properties fo:font-size="8pt" fo:color="#6b7280"/></style:style></office:automatic-styles><office:master-styles><style:master-page style:name="Standard" style:page-layout-name="pm1"><style:header><text:p text:style-name="Footer">AJUNTAMENT DE MAÓ · SERVEI DE RECAPTACIÓ · CIRCULAR</text:p></style:header><style:footer><text:p text:style-name="Footer">Model acadèmic · emplenau els camps entre claudàtors</text:p></style:footer></style:master-page></office:master-styles><office:body><office:text><text:p text:style-name="Org">AJUNTAMENT DE MAÓ · SERVEI DE RECAPTACIÓ</text:p><text:p text:style-name="Title">Termini per al pagament del rebut de l’IBI</text:p><text:p text:style-name="Callout">CIRCULAR</text:p><text:p text:style-name="Body">Benvolguts contribuents,</text:p><text:p text:style-name="Body">El Servei de Recaptació de l’Ajuntament de Maó recorda a les persones titulars de rebuts de l’impost sobre béns immobles (IBI) que el període indicat per efectuar-ne el pagament finalitza el pròxim 30 d’abril de [any].</text:p><text:p text:style-name="Body">Per evitar recàrrecs o altres conseqüències derivades del pagament fora de termini, us recomanam que comproveu les dades del rebut i efectueu el pagament pels canals habilitats per l’Ajuntament dins el període voluntari.</text:p><text:p text:style-name="Body">Aquesta circular és un model acadèmic: abans de publicar-la, cal substituir la data orientativa per les dates oficials del calendari fiscal vigent.</text:p><text:p text:style-name="Body">Maó, [data d’emissió]</text:p><text:p text:style-name="Body">Servei de Recaptació · Ajuntament de Maó</text:p></office:text></office:body></office:document>