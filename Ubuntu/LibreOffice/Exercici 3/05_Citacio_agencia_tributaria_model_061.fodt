<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" office:version="1.3">
<office:font-face-decls><style:font-face style:name="Liberation Sans" svg:font-family="Liberation Sans"/><style:font-face style:name="Liberation Serif" svg:font-family="Liberation Serif"/></office:font-face-decls>
<office:styles>
<style:default-style style:family="paragraph"><style:paragraph-properties fo:margin-bottom="0.12in" fo:line-height="125%"/><style:text-properties style:font-name="Liberation Sans" fo:font-size="10.5pt" fo:color="#263238"/></style:default-style>
<style:style style:name="Title" style:family="paragraph"><style:paragraph-properties fo:text-align="center" fo:margin-top="0.10in" fo:margin-bottom="0.04in"/><style:text-properties style:font-name="Liberation Serif" fo:font-size="25pt" fo:font-weight="bold" fo:color="#145A72"/></style:style>
<style:style style:name="Sub" style:family="paragraph"><style:paragraph-properties fo:text-align="center" fo:margin-bottom="0.32in"/><style:text-properties fo:font-size="10pt" fo:font-weight="bold" fo:letter-spacing="0.8pt" fo:color="#617780"/></style:style>
<style:style style:name="body" style:family="paragraph"><style:paragraph-properties fo:text-align="justify" fo:margin-bottom="0.13in"/><style:text-properties fo:font-size="10.5pt"/></style:style>
<style:style style:name="section" style:family="paragraph"><style:paragraph-properties fo:margin-top="0.12in" fo:margin-bottom="0.08in"/><style:text-properties fo:font-size="10.5pt" fo:font-weight="bold" fo:color="#145A72"/></style:style>
<style:style style:name="call" style:family="paragraph"><style:paragraph-properties fo:text-align="center" fo:margin-top="0.10in" fo:margin-bottom="0.16in" fo:background-color="#EAF2F5" fo:padding="0.10in"/><style:text-properties fo:font-size="12pt" fo:font-weight="bold" fo:color="#145A72"/></style:style>
<style:style style:name="small" style:family="paragraph"><style:paragraph-properties fo:margin-top="0.08in"/><style:text-properties fo:font-size="8.5pt" fo:color="#68777C" fo:font-style="italic"/></style:style>
<style:style style:name="right" style:family="paragraph"><style:paragraph-properties fo:text-align="end" fo:margin-top="0.18in"/><style:text-properties fo:font-size="10pt"/></style:style>
<style:style style:name="center" style:family="paragraph"><style:paragraph-properties fo:text-align="center" fo:margin-top="0.10in"/><style:text-properties fo:font-size="10pt" fo:font-weight="bold" fo:color="#145A72"/></style:style>
</office:styles>
<office:automatic-styles><style:page-layout style:name="Page" style:family="page-layout"><style:page-layout-properties fo:page-width="8.27in" fo:page-height="11.69in" fo:margin-top="0.78in" fo:margin-bottom="0.78in" fo:margin-left="0.85in" fo:margin-right="0.85in" style:print-orientation="portrait"/><style:header-style/><style:footer-style/></style:page-layout></office:automatic-styles>
<office:master-styles><style:master-page style:name="Standard" style:page-layout-name="Page"><style:header><text:p text:style-name="small">IES JOAN RAMIS I RAMIS · PLANTILLES ADMINISTRATIVES</text:p></style:header><style:footer><text:p text:style-name="small">Model editable · Revisau les dades entre claudàtors abans d’imprimir</text:p></style:footer></style:master-page></office:master-styles>
<office:body><office:text><text:p text:style-name="Title">CITACIÓ</text:p><text:p text:style-name="Sub">COMPAREIXENÇA PER A LA SIGNATURA DE DOCUMENTACIÓ</text:p><text:p text:style-name="section">[Nom de l’òrgan o oficina tributària]</text:p>
<text:p text:style-name="body">A l’atenció de: [nom i llinatges de la persona destinatària]</text:p>
<text:p text:style-name="body">Empresa: [raó social] · NIF: [NIF de l’empresa]</text:p>
<text:p text:style-name="section">Assumpte: signatura de documentació necessària per a la tramitació del model 061</text:p>
<text:p text:style-name="body">Per mitjà d’aquesta comunicació, us convocam perquè comparegueu a l’oficina indicada a fi de revisar i signar la documentació imprescindible per continuar la tramitació del model 061 de la vostra empresa.</text:p>
<text:p text:style-name="call">DIA: [dia] de [mes] de [any]</text:p>
<text:p text:style-name="call">HORA: [hora concreta]</text:p>
<text:p text:style-name="call">LLOC: [adreça i oficina]</text:p>
<text:p text:style-name="body">Cal que dugueu el document identificatiu i la documentació de representació de l’empresa que correspongui. Si no podeu assistir-hi, posau-vos en contacte amb l’oficina emissora per consultar com modificar la cita.</text:p>
<text:p text:style-name="right">Maó, [data d’emissió]</text:p>
<text:p text:style-name="center">[Nom i càrrec de la persona responsable]</text:p>
<text:p text:style-name="center">[Signatura i segell de l’organisme]</text:p></office:text></office:body></office:document>